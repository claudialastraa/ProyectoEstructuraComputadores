; ----------------------
; MACROS
; ----------------------

PUSH: MACRO (reg)
    subu r30, r30, 4
    st reg, r30, 0
    ENDMACRO

POP: MACRO (reg)
    ld reg, r30, 0
    addu r30, r30, 4
    ENDMACRO

LEA: MACRO (reg, ETIQ)
    or reg, r0, low(ETIQ)
    or.u reg, reg, high(ETIQ)
    ENDMACRO

LOAD: MACRO (ra, ETIQ)
    LEA(ra, ETIQ)
    ld ra, ra, 0
    ENDMACRO

